// Cloudflare Workers の設定。
// ダッシュボードの「Root directory」は空欄（リポジトリ直下）、Build command は npm run build。
// 画面（apps/web/dist）は静的配信、/api/* だけ Worker（apps/api）が処理する。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sabakan",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // メンバー表。database_id を書かなければ、初回デプロイ時に Cloudflare が自動で作る
  "d1_databases": [{ "binding": "DB", "database_name": "sabakan" }],
  // 共同編集の部屋（ページごと）。無料プランで使える SQLite 版
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "PageRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PageRoom"] }],
  // 公開してよい値。GOOGLE_CLIENT_SECRET はダッシュボードの「変数とシークレット」に登録する
  "vars": {
    "GOOGLE_CLIENT_ID": "519549570563-vu6jjho0bb6cv9eakm7e888na83s8suj.apps.googleusercontent.com"
  }
}
